+/*
+ * X.691 octet-alignment primitives (see ADR-0031). nboff, after normalization inside
+ * asn_get_few_bits/asn_put_few_bits, always tracks the bit position within the current octet in
+ * its low 3 bits regardless of how large it grows between calls (mod-8 arithmetic), so no
+ * separate absolute bit counter is needed here.
+ */
+int32_t
+asn_get_align(asn_bit_data_t *pd) {
+	unsigned pad = (unsigned)((8 - (pd->nboff & 0x07)) & 0x07);
+	if(pad == 0) return 0;
+	return asn_get_few_bits(pd, (int)pad);
+}
+
+int
+asn_put_align(asn_bit_outp_t *po) {
+	unsigned pad = (unsigned)((8 - (po->nboff & 0x07)) & 0x07);
+	if(pad == 0) return 0;
+	return asn_put_few_bits(po, 0, (int)pad);
+}
+
