+/*
+ * X.691 clause 27 (character string types), ALIGNED PER variant -- see ADR-0031. A PER-visible
+ * character/alphabet constraint's exact minimal bit width (e.g. 7 bits for a 91-symbol
+ * PrintableString alphabet spanning 32..122) is only used as-is by Unaligned PER. The Aligned
+ * variant instead rounds the per-character unit up to the smallest "canonical" width in
+ * {1, 2, 4, 8, 16, 32} bits -- confirmed empirically against a real gNB's own reference asn1c
+ * decoder (compiled from simulators/ransim/vendor/UERANSIM's vendored sources as an oracle):
+ * AMFName (PrintableString, alphabet range_bits=7) is packed 8 bits/character in Aligned PER, not
+ * 7 -- this project's first attempt used the raw range_bits unconditionally, corrupting every
+ * PER-visible-alphabet-constrained string this project encodes or decodes.
+ */
+static inline unsigned int
+aper_char_unit_bits(int aligned, unsigned int range_bits) {
+    if(!aligned) return range_bits;
+    if(range_bits <= 1) return 1;
+    if(range_bits <= 2) return 2;
+    if(range_bits <= 4) return 4;
+    if(range_bits <= 8) return 8;
+    if(range_bits <= 16) return 16;
+    return 32;
+}
 
 
